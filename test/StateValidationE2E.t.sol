pragma solidity ^0.8.27;

import { Test } from "forge-std/Test.sol";

import { ERC8039Constants } from "../contracts/ERC8039/IERC8039.sol";
import { PrivateStateValidationProofVerifier } from "../contracts/ERC8039/PrivateStateValidationProofVerifier.sol";
import { HonkVerifier } from "../noir/target/zk_multi_sig_ecdsa_private_state_validation.sol";
import { ZKMultiSigEcdsaFactory } from "../contracts/safe/ZKMultiSigEcdsaFactory.sol";
import { ZKMultiSigValidator } from "../contracts/nexus/modules/validators/ZKMultiSigValidator.sol";

/// @notice End-to-end check of the salted commitment: a real UltraHonk proof generated by the SDK
///         (`proveStateConfiguration`, see test/fixtures) must verify through the regenerated
///         HonkVerifier, the ERC-8039 adapter, the Safe factory and the Nexus validator.
contract StateValidationE2ETest is Test {
    HonkVerifier honk;
    PrivateStateValidationProofVerifier adapter;
    bytes proof;
    bytes32 stateRoot;

    function setUp() public {
        honk = new HonkVerifier();
        adapter = new PrivateStateValidationProofVerifier(honk);
        proof = vm.parseBytes(vm.readFile("test/fixtures/state_validation_proof.hex"));
        stateRoot = vm.parseBytes32(vm.readFile("test/fixtures/state_validation_root.hex"));
    }

    function test_realProof_verifiesThroughAdapter() public view {
        bytes32[] memory inputs = new bytes32[](1);
        inputs[0] = stateRoot;
        assertEq(adapter.verifyProof(abi.encode(inputs), proof), ERC8039Constants.PROOF_MAGIC_VALUE);
    }

    function test_realProof_wrongRootRejected_noRevert() public view {
        bytes32[] memory inputs = new bytes32[](1);
        inputs[0] = bytes32(uint256(stateRoot) ^ 1);
        assertEq(adapter.verifyProof(abi.encode(inputs), proof), bytes4(0));
    }

    function test_realProof_safeFactoryCreatesSigner() public {
        ZKMultiSigEcdsaFactory factory = new ZKMultiSigEcdsaFactory(address(adapter));
        address txVerifier = makeAddr("txVerifier");
        address signer = factory.createSigner(stateRoot, txVerifier, proof);
        assertEq(signer, factory.getSigner(stateRoot, txVerifier));
        assertGt(signer.code.length, 0);
    }

    function test_realProof_nexusValidatorInstalls() public {
        ZKMultiSigValidator validator = new ZKMultiSigValidator(address(adapter), makeAddr("txVerifier"));
        validator.onInstall(abi.encode(stateRoot, proof));
        assertEq(validator.getStateRoot(address(this)), stateRoot);

        address other = makeAddr("other");
        vm.prank(other);
        vm.expectRevert(ZKMultiSigValidator.InvalidOffChainState.selector);
        validator.onInstall(abi.encode(bytes32(uint256(stateRoot) ^ 1), proof));
    }
}
